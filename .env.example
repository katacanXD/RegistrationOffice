DB_NAME=postgres
DB_USER=postgres
DB_PASS=admin
SECURITY_JWT_SECRET=change_me_super_long_random_secret_min_32_chars
APP_SECURITY_CORS_ALLOWED_ORIGINS=
APP_SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=
SSL_PATH=/etc/letsencrypt
VITE_API_BASE_URL=http://<url>/api/v1

# Examples:
# APP_SECURITY_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# APP_SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.example.com
